# Copy to .env and fill with values from Supabase → Project Settings → API (Connect).
# Do not commit .env.

# Public site URL (no trailing slash). Used for Open Graph / Twitter card images.
VITE_SITE_URL=https://appraisal.prodg.studio

# ProDG Appraisal — production Supabase project (eu-west-1)
VITE_SUPABASE_PROJECT_ID=pklukpdoymfmzamdyjbt
VITE_SUPABASE_URL=https://pklukpdoymfmzamdyjbt.supabase.co
# Project API keys → anon public (publishable)
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# Optional: URL to the admin dashboard Excel export (default: /data/VGG_360_Reorganized.xlsx)
VITE_APPRAISAL_DATA_URL=

# Optional: legacy /admin login (client-side only — prefer employee admin in production)
VITE_LEGACY_ADMIN_EMAIL=
VITE_LEGACY_ADMIN_PASSWORD=
VITE_LEGACY_ADMIN_NAME=

# Server-only — never expose in the browser. Supabase → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# One-time roster import: npm run seed:users (after db push)
SEED_DEFAULT_PASSWORD=
